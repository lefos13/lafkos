---
import '../styles/global.css';
import { otherLocale, type Locale } from '../lib/locales';
import { getCopy } from '../lib/ui-copy';
import { fetchSanityContent } from '../lib/content-api';
import { formatPageTitle, getLocalizedUrlPaths } from '../lib/urls';
import { serializeJsonLd } from '../lib/structured-data';

interface Props {
  locale: Locale;
  title: string;
  description: string;
  image?: string;
  imageAlt?: string;
  imageWidth?: number | string;
  imageHeight?: number | string;
  imageType?: string;
  type?: 'website' | 'article';
  robots?: string;
  author?: string;
  publishedAt?: string;
  modifiedAt?: string;
  darkHeader?: boolean;
  minimalHeader?: boolean;
  isMapPage?: boolean;
  alternateHref?: string;
  contentSource?: 'sanity' | 'seed';
  jsonLd?: unknown;
}

const {
  locale,
  title,
  description,
  image,
  imageAlt,
  imageWidth,
  imageHeight,
  imageType,
  type = 'website',
  robots,
  author,
  publishedAt,
  modifiedAt,
  darkHeader = false,
  minimalHeader = false,
  jsonLd,
  isMapPage = false,
  alternateHref,
  contentSource,
} = Astro.props;
const ui = getCopy(locale);
const alternateLocale = otherLocale(locale);
/*
 * Canonical and language URLs are built from one normalized path contract.
 * Detail pages pass translated slugs through alternateHref, allowing the
 * Greek x-default link to point at the matching entity rather than /el/.
 */
const { canonicalPath, alternatePath, xDefaultPath } = getLocalizedUrlPaths({
  locale,
  pathname: Astro.url.pathname,
  alternatePath: alternateHref,
});
const siteUrl = Astro.site ?? new URL('https://lafkos-guide.vercel.app');
const canonical = new URL(canonicalPath, siteUrl).toString();
const alternateUrl = new URL(alternatePath, siteUrl).toString();
const xDefaultUrl = new URL(xDefaultPath, siteUrl).toString();
/*
 * Social sharing image resolution:
 * Resolves absolute image URLs for Open Graph and Twitter cards, defaulting to
 * the dedicated 1200x630 raster PNG social card asset when no entity image is provided.
 */
const defaultSocialImagePath = '/images/og-default.png';
const isDefaultImage = !image;
const socialImageUrl = image
  ? image.startsWith('http://') || image.startsWith('https://')
    ? image
    : new URL(image, siteUrl).toString()
  : new URL(defaultSocialImagePath, siteUrl).toString();

const defaultAlt =
  locale === 'el'
    ? 'Lafkos Guide — Οδηγός Λαύκου και Νοτίου Πηλίου'
    : 'Lafkos Guide — Cultural Guide to Lafkos & South Pelion';

const socialImageAlt = imageAlt ?? (isDefaultImage ? defaultAlt : title);
const socialImageWidth = imageWidth ? String(imageWidth) : isDefaultImage ? '1200' : undefined;
const socialImageHeight = imageHeight ? String(imageHeight) : isDefaultImage ? '630' : undefined;

function inferImageType(url: string, explicitType?: string): string | undefined {
  if (explicitType) return explicitType;
  try {
    const pathname = new URL(url).pathname.toLowerCase();
    if (pathname.endsWith('.png')) return 'image/png';
    if (pathname.endsWith('.jpg') || pathname.endsWith('.jpeg')) return 'image/jpeg';
    if (pathname.endsWith('.webp')) return 'image/webp';
    if (pathname.endsWith('.svg')) return 'image/svg+xml';
  } catch {
    if (url.endsWith('.png')) return 'image/png';
    if (url.endsWith('.jpg') || url.endsWith('.jpeg')) return 'image/jpeg';
    if (url.endsWith('.webp')) return 'image/webp';
    if (url.endsWith('.svg')) return 'image/svg+xml';
  }
  return undefined;
}

const socialImageType = inferImageType(
  socialImageUrl,
  imageType ?? (isDefaultImage ? 'image/png' : undefined),
);

/*
 * Page title composition:
 * Composes a unique title string with the brand suffix when it fits the SERP
 * budget; long editorial titles keep their full wording without truncation.
 */
const pageTitle = formatPageTitle(title);
const dataset = await fetchSanityContent();
const activeSource = contentSource ?? dataset.source;
const isCms = activeSource === 'sanity';
const navEventsLabel = locale === 'el' ? 'Εκδηλώσεις' : 'Events';
const navTimelineLabel = locale === 'el' ? 'Χρονολόγιο' : 'Timeline';
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="theme-color" content="#24433f" />
    <meta name="description" content={description} />
    {author && <meta name="author" content={author} />}
    {robots && <meta name="robots" content={robots} />}
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Newsreader:opsz,wght@6..72,400;6..72,500;6..72,600&display=swap"
    />
    <slot name="head" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang={locale} href={canonical} />
    <link rel="alternate" hreflang={alternateLocale} href={alternateUrl} />
    <link rel="alternate" hreflang="x-default" href={xDefaultUrl} />
    <meta property="og:site_name" content="Lafkos Guide" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={locale === 'el' ? 'el_GR' : 'en_US'} />
    <meta property="og:locale:alternate" content={locale === 'el' ? 'en_US' : 'el_GR'} />
    <meta property="og:image" content={socialImageUrl} />
    <meta property="og:image:alt" content={socialImageAlt} />
    {socialImageWidth && <meta property="og:image:width" content={socialImageWidth} />}
    {socialImageHeight && <meta property="og:image:height" content={socialImageHeight} />}
    {socialImageType && <meta property="og:image:type" content={socialImageType} />}
    {publishedAt && <meta property="article:published_time" content={publishedAt} />}
    {modifiedAt && <meta property="article:modified_time" content={modifiedAt} />}
    {author && <meta property="article:author" content={author} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageUrl} />
    <meta name="twitter:image:alt" content={socialImageAlt} />
    <title>{pageTitle}</title>
    {
      /*
       * Structured Data (JSON-LD):
       * Safely injects escaped Schema.org metadata graphs for SEO rich results
       * without exposing the document to script termination vulnerabilities.
       */
    }
    {jsonLd && <script is:inline type="application/ld+json" set:html={serializeJsonLd(jsonLd)} />}
  </head>
  <body>
    <a class="skip-link" href="#main-content">{ui.skipToContent}</a>
    <div class="site-shell">
      <header
        class:list={[
          'site-header',
          {
            'site-header--dark': darkHeader,
            'site-header--minimal': minimalHeader || isMapPage,
          },
        ]}
      >
        <a class="brand" href={`/${locale}/`} aria-label={ui.home}>
          <span class="brand-mark" aria-hidden="true">λ</span>
          <span class="brand-name">Lafkos Guide</span>
        </a>
        <nav class="nav-links" aria-label={ui.primaryNav}>
          <a href={`/${locale}/map/`}>{ui.navMap}</a>
          <a href={`/${locale}/places/`}>{ui.navPlaces}</a>
          <a href={`/${locale}/trails/`}>{ui.navTrails}</a>
          <a href={`/${locale}/stories/`}>{ui.navStories}</a>
          <a href={`/${locale}/events/`}>{navEventsLabel}</a>
          <a href={`/${locale}/timeline/`}>{navTimelineLabel}</a>
          <a href={`/${locale}/visit/`}>{ui.navVisit}</a>
          <a href={`/${locale}/about/`}>{ui.navAbout}</a>
          <a class="language-link" href={alternatePath}>{ui.language}</a>
        </nav>
        <a class="mobile-lang-link" href={alternatePath} aria-label={ui.language}>
          {alternateLocale.toUpperCase()}
        </a>
      </header>
      <main id="main-content"><slot /></main>
      <footer class="site-footer">
        <div class="container footer-inner">
          <div>
            <a class="brand" href={`/${locale}/`}
              ><span class="brand-mark" aria-hidden="true">λ</span><span>Lafkos Guide</span></a
            >
            <p class="footer-copy">{ui.footer}</p>
          </div>
          <nav class="footer-links" aria-label={ui.footerNav}>
            <a href={`/${locale}/places/`}>{ui.navPlaces}</a>
            <a href={`/${locale}/trails/`}>{ui.navTrails}</a>
            <a href={`/${locale}/stories/`}>{ui.navStories}</a>
            <a href={`/${locale}/events/`}>{navEventsLabel}</a>
            <a href={`/${locale}/timeline/`}>{navTimelineLabel}</a>
            <a href={`/${locale}/about/`}>{ui.navAbout}</a>
            <a href={`/${locale}/privacy/`}>{ui.privacyTitle}</a>
            <a href={`/${locale}/accessibility/`}>{ui.accessibilityTitle}</a>
            <a href={alternatePath}>{ui.language}</a>
          </nav>
        </div>
        <div class="container footer-status-wrap">
          {
            isCms ? (
              <aside
                class="footer-status footer-status--cms"
                role="status"
                aria-label={ui.dataSource}
              >
                <span class="footer-status-dot" aria-hidden="true" />
                <span class="footer-status-text">
                  {ui.dataSource} <strong>{ui.cmsLiveTitle}</strong>
                </span>
                <span class="footer-status-badge footer-status-badge--cms">{ui.cmsLiveBadge}</span>
              </aside>
            ) : (
              <aside
                class="footer-status footer-status--warning"
                role="alert"
                aria-label={ui.dataSource}
              >
                <div class="footer-status-warning-header">
                  <span class="footer-status-icon" aria-hidden="true">
                    ⚠️
                  </span>
                  <strong>{ui.seedFallbackTitle}</strong>
                  <span class="footer-status-badge footer-status-badge--warning">
                    {ui.seedFallbackBadge}
                  </span>
                </div>
                <p class="footer-status-desc">{ui.seedFallbackWarning}</p>
              </aside>
            )
          }
        </div>
      </footer>
    </div>
    <script define:vars={{ isProd: import.meta.env.PROD }} is:inline>
      if ('serviceWorker' in navigator) {
        if (isProd) {
          navigator.serviceWorker.register('/sw.js').catch(() => undefined);
        } else {
          navigator.serviceWorker.getRegistrations().then((registrations) => {
            for (const registration of registrations) {
              registration.unregister();
            }
          });
          if (typeof caches !== 'undefined') {
            caches.keys().then((keys) => {
              for (const key of keys) {
                caches.delete(key);
              }
            });
          }
        }
      }
    </script>
  </body>
</html>
