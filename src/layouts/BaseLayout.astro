---
import '../styles/global.css';
import { otherLocale, type Locale } from '../lib/locales';
import { getCopy } from '../lib/ui-copy';
import { fetchSanityContent } from '../lib/content-api';
import { getLocalizedUrlPaths } from '../lib/urls';

interface Props {
  locale: Locale;
  title: string;
  description: string;
  image?: string;
  darkHeader?: boolean;
  minimalHeader?: boolean;
  isMapPage?: boolean;
  alternateHref?: string;
  contentSource?: 'sanity' | 'seed';
}

const {
  locale,
  title,
  description,
  image,
  darkHeader = false,
  minimalHeader = false,
  isMapPage = false,
  alternateHref,
  contentSource,
} = Astro.props;
const ui = getCopy(locale);
const alternateLocale = otherLocale(locale);
/*
 * Canonical and language URLs are built from one normalized path contract.
 * Detail pages pass translated slugs through alternateHref, allowing the
 * Greek x-default link to point at the matching entity rather than /el/.
 */
const { canonicalPath, alternatePath, xDefaultPath } = getLocalizedUrlPaths({
  locale,
  pathname: Astro.url.pathname,
  alternatePath: alternateHref,
});
const siteUrl = Astro.site ?? new URL('https://lafkos-guide.vercel.app');
const canonical = new URL(canonicalPath, siteUrl).toString();
const alternateUrl = new URL(alternatePath, siteUrl).toString();
const xDefaultUrl = new URL(xDefaultPath, siteUrl).toString();
const socialImage = image ?? new URL('/icons/icon-512.svg', siteUrl).toString();
const dataset = await fetchSanityContent();
const activeSource = contentSource ?? dataset.source;
const isCms = activeSource === 'sanity';
const navEventsLabel = locale === 'el' ? 'Εκδηλώσεις' : 'Events';
const navTimelineLabel = locale === 'el' ? 'Χρονολόγιο' : 'Timeline';
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="theme-color" content="#24433f" />
    <meta name="build-revision" content="2026-08-20-csp-2" />
    <meta name="description" content={description} />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang={locale} href={canonical} />
    <link rel="alternate" hreflang={alternateLocale} href={alternateUrl} />
    <link rel="alternate" hreflang="x-default" href={xDefaultUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <title>{title} · Lafkos Guide</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">{ui.skipToContent}</a>
    <div class="site-shell">
      <header
        class:list={[
          'site-header',
          {
            'site-header--dark': darkHeader,
            'site-header--minimal': minimalHeader || isMapPage,
          },
        ]}
      >
        <a class="brand" href={`/${locale}/`} aria-label={ui.home}>
          <span class="brand-mark" aria-hidden="true">λ</span>
          <span class="brand-name">Lafkos Guide</span>
        </a>
        <nav class="nav-links" aria-label={ui.primaryNav}>
          <a href={`/${locale}/map`}>{ui.navMap}</a>
          <a href={`/${locale}/stories/reading-lafkos`}>{ui.navStories}</a>
          <a href={`/${locale}/events`}>{navEventsLabel}</a>
          <a href={`/${locale}/timeline`}>{navTimelineLabel}</a>
          <a href={`/${locale}/visit`}>{ui.navVisit}</a>
          <a href={`/${locale}/about`}>{ui.navAbout}</a>
          <a class="language-link" href={alternatePath}>{ui.language}</a>
        </nav>
        <a class="mobile-lang-link" href={alternatePath} aria-label={ui.language}>
          {alternateLocale.toUpperCase()}
        </a>
      </header>
      <main id="main-content"><slot /></main>
      <footer class="site-footer">
        <div class="container footer-inner">
          <div>
            <a class="brand" href={`/${locale}/`}
              ><span class="brand-mark" aria-hidden="true">λ</span><span>Lafkos Guide</span></a
            >
            <p class="footer-copy">{ui.footer}</p>
          </div>
          <nav class="footer-links" aria-label={ui.footerNav}>
            <a href={`/${locale}/events`}>{navEventsLabel}</a>
            <a href={`/${locale}/timeline`}>{navTimelineLabel}</a>
            <a href={`/${locale}/about`}>{ui.navAbout}</a>
            <a href={`/${locale}/privacy`}>{ui.privacyTitle}</a>
            <a href={`/${locale}/accessibility`}>{ui.accessibilityTitle}</a>
            <a href={alternatePath}>{ui.language}</a>
          </nav>
        </div>
        <div class="container footer-status-wrap">
          {
            isCms ? (
              <aside
                class="footer-status footer-status--cms"
                role="status"
                aria-label={ui.dataSource}
              >
                <span class="footer-status-dot" aria-hidden="true" />
                <span class="footer-status-text">
                  {ui.dataSource} <strong>{ui.cmsLiveTitle}</strong>
                </span>
                <span class="footer-status-badge footer-status-badge--cms">{ui.cmsLiveBadge}</span>
              </aside>
            ) : (
              <aside
                class="footer-status footer-status--warning"
                role="alert"
                aria-label={ui.dataSource}
              >
                <div class="footer-status-warning-header">
                  <span class="footer-status-icon" aria-hidden="true">
                    ⚠️
                  </span>
                  <strong>{ui.seedFallbackTitle}</strong>
                  <span class="footer-status-badge footer-status-badge--warning">
                    {ui.seedFallbackBadge}
                  </span>
                </div>
                <p class="footer-status-desc">{ui.seedFallbackWarning}</p>
              </aside>
            )
          }
        </div>
      </footer>
    </div>
    <script define:vars={{ isProd: import.meta.env.PROD }} is:inline>
      if ('serviceWorker' in navigator) {
        if (isProd) {
          navigator.serviceWorker.register('/sw.js').catch(() => undefined);
        } else {
          navigator.serviceWorker.getRegistrations().then((registrations) => {
            for (const registration of registrations) {
              registration.unregister();
            }
          });
          if (typeof caches !== 'undefined') {
            caches.keys().then((keys) => {
              for (const key of keys) {
                caches.delete(key);
              }
            });
          }
        }
      }
    </script>
  </body>
</html>
