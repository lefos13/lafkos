---
import BaseLayout from '../../layouts/BaseLayout.astro';
import FeatureCard from '../../components/FeatureCard.astro';
import StoryCard from '../../components/StoryCard.astro';
import SeedNotice from '../../components/SeedNotice.astro';
import {
  featuredPlaces,
  featuredStories,
  featuredTrails,
  fetchSanityContent,
} from '../../lib/content-api';
import { locales, type Locale } from '../../lib/locales';
import { getCopy } from '../../lib/ui-copy';
import { buildHomeJsonLd } from '../../lib/structured-data';

export function getStaticPaths() {
  return locales.map((locale) => ({ params: { locale }, props: { locale } }));
}

const { locale } = Astro.props as { locale: Locale };
const ui = getCopy(locale);
const dataset = await fetchSanityContent();
const places = featuredPlaces(dataset.places);
const trails = featuredTrails(dataset.trails);
const stories = featuredStories(dataset.stories);
const categories = dataset.categories;

const statsEyebrow = locale === 'el' ? 'Λαύκος σε αριθμούς' : 'Lafkos in numbers';
const statsTitle = locale === 'el' ? 'Ο τόπος με μια ματιά.' : 'The village at a glance.';
const ctaEventsLabel = locale === 'el' ? 'Ο ετήσιος κύκλος' : 'The Annual Cycle';
const ctaTimelineLabel = locale === 'el' ? 'Ιστορικό χρονολόγιο' : 'Historical Timeline';

const statsItems = [
  {
    value: '1785',
    label: locale === 'el' ? 'Καφενείο Φορλίδα' : 'Forlidas Café',
    caption: locale === 'el' ? 'το αρχαιότερο καφενείο της Ελλάδας' : "Greece's oldest café",
  },
  {
    value: locale === 'el' ? '3 μουσεία' : '3 museums',
    label: locale === 'el' ? 'Πολιτισμός' : 'Culture',
    caption: locale === 'el' ? 'για 378 κατοίκους' : 'museums for 378 residents',
  },
  {
    value: locale === 'el' ? '168 χλμ.' : '168 km',
    label: 'Long Pelion Trail',
    caption:
      locale === 'el'
        ? 'το εμβληματικό δίκτυο πεζοπορίας του Πηλίου'
        : 'flagship long-distance trail at our doorstep',
  },
  {
    value: locale === 'el' ? '16 διαδρομές' : '16 routes',
    label: locale === 'el' ? 'Αναρρίχηση' : 'Climbing',
    caption: locale === 'el' ? 'αναρριχητικό πεδίο του Μικρού' : 'climbing routes at Mikro',
  },
  {
    value: locale === 'el' ? '5 καταλύματα' : '5 guesthouses',
    label: locale === 'el' ? 'Φιλοξενία' : 'Hospitality',
    caption:
      locale === 'el'
        ? 'παραδοσιακή διαμονή σε ιστορικά αρχοντικά'
        : 'traditional stays in historic mansions',
  },
  {
    value: locale === 'el' ? 'Πεζοδρομημένο' : 'Car-free',
    label: locale === 'el' ? 'Ήπιος Ρυθμός' : 'Pace of Life',
    caption: locale === 'el' ? 'η καρδιά του χωριού χωρίς αυτοκίνητα' : 'car-free village heart',
  },
];
/*
 * Structured Data:
 * Stable site-wide WebSite and Organization Schema.org graphs for the homepage.
 */
const jsonLd = buildHomeJsonLd();
---

<BaseLayout
  locale={locale}
  title={ui.explore}
  description={ui.introLong}
  darkHeader
  jsonLd={jsonLd}
>
  <section class="hero">
    <div class="hero-content">
      <p class="eyebrow">Νότιο Πήλιο · South Pelion</p>
      <h1 class="display">{locale === 'el' ? 'Λαύκος' : 'Lafkos'}</h1>
      <p class="lede">{ui.introLong}</p>
      <div class="hero-actions">
        <a class="button button-primary" href={`/${locale}/map/`}
          >{ui.explore} <span aria-hidden="true">↗</span></a
        >
        <a class="button button-ghost" href={`/${locale}/stories/`}>{ui.navStories}</a>
      </div>
    </div>
  </section>

  <section class="stats-band container" aria-labelledby="stats-title">
    <div class="stats-header">
      <div>
        <p class="eyebrow">{statsEyebrow}</p>
        <h2 id="stats-title" class="section-title">{statsTitle}</h2>
      </div>
      <div class="stats-ctas">
        <a class="button button-secondary stats-cta-btn" href={`/${locale}/events/`}>
          <span>{ctaEventsLabel}</span>
          <span class="cta-arrow" aria-hidden="true">→</span>
        </a>
        <a class="button button-secondary stats-cta-btn" href={`/${locale}/timeline/`}>
          <span>{ctaTimelineLabel}</span>
          <span class="cta-arrow" aria-hidden="true">→</span>
        </a>
      </div>
    </div>

    <div class="stats-grid">
      {
        statsItems.map((stat) => (
          <div class="stat-card">
            <p class="stat-label">{stat.label}</p>
            <div class="stat-value">{stat.value}</div>
            <p class="stat-caption">{stat.caption}</p>
          </div>
        ))
      }
    </div>
  </section>

  <section class="map-section container" aria-labelledby="map-title">
    <div class="section-header">
      <div>
        <p class="eyebrow">{ui.explore}</p>
        <h2 id="map-title" class="section-title">
          {locale === 'el' ? 'Βρες τον δρόμο σου.' : 'Find your way in.'}
        </h2>
      </div>
      <a class="text-link" href={`/${locale}/map/`}>{ui.viewAll}</a>
    </div>

    <div class="map-teaser-card">
      <div class="map-teaser-visual">
        <div class="map-teaser-canvas">
          <div class="map-teaser-grid" aria-hidden="true"></div>
          <svg
            class="map-teaser-svg"
            viewBox="0 0 600 360"
            fill="none"
            xmlns="http://www.w3.org/2000/svg"
            aria-hidden="true"
          >
            <path
              d="M-20 80 Q 140 40 300 110 T 620 90"
              stroke="rgba(79, 103, 87, 0.2)"
              stroke-width="1.5"
              stroke-dasharray="4 6"></path>
            <path
              d="M-20 160 Q 180 120 340 190 T 620 150"
              stroke="rgba(79, 103, 87, 0.2)"
              stroke-width="1.5"
              stroke-dasharray="4 6"></path>
            <path
              d="M-20 240 Q 220 200 380 270 T 620 230"
              stroke="rgba(79, 103, 87, 0.2)"
              stroke-width="1.5"
              stroke-dasharray="4 6"></path>
            <path
              d="M-20 320 Q 260 280 420 330 T 620 310"
              stroke="rgba(79, 103, 87, 0.2)"
              stroke-width="1.5"
              stroke-dasharray="4 6"></path>
            <path
              d="M120 340 C 160 260, 220 240, 290 190 C 350 140, 420 130, 490 60"
              stroke="var(--terracotta)"
              stroke-width="2.5"
              stroke-linecap="round"
              stroke-dasharray="2 5"></path>
            <path
              d="M290 190 C 260 140, 220 110, 170 70"
              stroke="var(--sea)"
              stroke-width="2"
              stroke-linecap="round"
              stroke-dasharray="3 4"></path>
            <path
              d="M290 190 C 360 220, 430 260, 520 290"
              stroke="var(--gold)"
              stroke-width="2"
              stroke-linecap="round"
              stroke-dasharray="3 4"></path>
          </svg>

          <div class="map-teaser-pins" aria-hidden="true">
            <div class="map-pin" style="top: 50%; left: 47%;">
              <span class="map-pin-dot map-pin-dot--terracotta"></span>
              <span class="map-pin-label"
                >{locale === 'el' ? 'Πλατεία & Φορλίδας' : 'Square & Forlidas'}</span
              >
            </div>
            <div class="map-pin" style="top: 24%; left: 26%;">
              <span class="map-pin-dot map-pin-dot--sea"></span>
              <span class="map-pin-label"
                >{locale === 'el' ? 'Καλντερίμι Μηλίνας' : 'Milina Kalderimi'}</span
              >
            </div>
            <div class="map-pin" style="top: 76%; left: 80%;">
              <span class="map-pin-dot map-pin-dot--gold"></span>
              <span class="map-pin-label"
                >{locale === 'el' ? 'Μικρό & Αιγαίο' : 'Mikro & Aegean'}</span
              >
            </div>
            <div class="map-pin" style="top: 18%; left: 78%;">
              <span class="map-pin-dot map-pin-dot--olive"></span>
              <span class="map-pin-label"
                >{locale === 'el' ? 'Αγ. Αθανάσιος' : 'Ag. Athanasios'}</span
              >
            </div>
          </div>

          <div class="map-teaser-badge" aria-hidden="true">
            <span class="badge-icon">🗺️</span>
            <span class="badge-text"
              >{locale === 'el' ? '45+ Σημεία & Διαδρομές' : '45+ Places & Routes'}</span
            >
          </div>
          <div class="map-teaser-coords" aria-hidden="true">
            <span>39°10′35″N · 23°14′45″E</span>
          </div>
        </div>
      </div>

      <div class="map-teaser-content">
        <h3 class="map-teaser-heading">
          {
            locale === 'el'
              ? 'Πλοηγηθείτε σε όλο το ανάγλυφο του χωριού.'
              : 'Explore the full topography of the village.'
          }
        </h3>
        <p class="map-teaser-desc">
          {
            locale === 'el'
              ? 'Ανακαλύψτε ιστορικά αρχοντικά, μουσεία, κρήνες του 18ου αιώνα, καθώς και το πλήρες δίκτυο μονοπατιών προς τον Παγασητικό και το Αιγαίο με διαδραστικό εντοπισμό θέσης.'
              : 'Discover 18th-century stone mansions, historic fountains, museums, and the complete network of hiking trails connecting Lafkos to the Pagasetic Gulf and the Aegean Sea.'
          }
        </p>

        <div class="map-teaser-features">
          <div class="teaser-feature">
            <span class="feature-bullet" aria-hidden="true">🏛️</span>
            <div>
              <strong>{locale === 'el' ? 'Πολιτισμός & Μουσεία' : 'Heritage & Museums'}</strong>
              <span
                >{
                  locale === 'el'
                    ? '3 μουσεία, καφενείο 1785, εκκλησίες'
                    : '3 museums, 1785 café, churches'
                }</span
              >
            </div>
          </div>
          <div class="teaser-feature">
            <span class="feature-bullet" aria-hidden="true">🥾</span>
            <div>
              <strong>{locale === 'el' ? 'Μονοπάτια & Καλντερίμια' : 'Trails & Stone Paths'}</strong
              >
              <span
                >{
                  locale === 'el'
                    ? 'Long Pelion Trail, διαδρομές προς Μικρό'
                    : 'Long Pelion Trail, routes to Mikro'
                }</span
              >
            </div>
          </div>
          <div class="teaser-feature">
            <span class="feature-bullet" aria-hidden="true">📍</span>
            <div>
              <strong>{locale === 'el' ? 'GPS & Φίλτρα' : 'Live GPS & Filters'}</strong>
              <span
                >{
                  locale === 'el'
                    ? 'Άμεση αναζήτηση και εντοπισμός θέσης'
                    : 'Instant search and live geolocation'
                }</span
              >
            </div>
          </div>
        </div>

        <div class="map-teaser-actions">
          <a class="button button-primary map-cta-button" href={`/${locale}/map/`}>
            <span>{locale === 'el' ? 'Άνοιγμα Διαδραστικού Χάρτη' : 'Open Interactive Map'}</span>
            <span class="cta-arrow" aria-hidden="true">↗</span>
          </a>
          <a class="button button-ghost map-secondary-button" href={`/${locale}/trails/`}>
            <span>{locale === 'el' ? 'Όλες οι διαδρομές' : 'Browse all trails'}</span>
            <span aria-hidden="true">→</span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <section class="section container" aria-labelledby="places-title">
    <div class="section-header">
      <div>
        <p class="eyebrow">{ui.navPlaces}</p>
        <h2 id="places-title" class="section-title">
          {locale === 'el' ? 'Μέρη & Αξιοθέατα' : 'Places & Landmarks'}
        </h2>
      </div>
      <a class="text-link" href={`/${locale}/places/`}>{ui.viewAll}</a>
    </div>
    <div class="card-grid">
      {
        places.map((place) => (
          <FeatureCard
            entry={place}
            locale={locale}
            category={categories.find((category) => category.id === place.category)}
          />
        ))
      }
    </div>
  </section>

  <section class="section container" aria-labelledby="trails-title">
    <div class="section-header">
      <div>
        <p class="eyebrow">{ui.navTrails}</p>
        <h2 id="trails-title" class="section-title">
          {locale === 'el' ? 'Πεζοπορικές Διαδρομές' : 'Hiking Trails'}
        </h2>
      </div>
      <a class="text-link" href={`/${locale}/trails/`}>{ui.viewAll}</a>
    </div>
    <div class="card-grid">
      {
        trails.map((trail) => (
          <FeatureCard
            entry={trail}
            locale={locale}
            category={categories.find((category) => category.id === 'trail')}
          />
        ))
      }
    </div>
  </section>

  <section class="section container" aria-labelledby="stories-title">
    <div class="section-header">
      <div>
        <p class="eyebrow">{ui.stories}</p>
        <h2 id="stories-title" class="section-title">
          {locale === 'el' ? 'Ο τόπος συνεχίζει να μιλά.' : 'The place keeps speaking.'}
        </h2>
      </div>
      <a class="text-link" href={`/${locale}/stories/`}>{ui.viewAll}</a>
    </div>
    <div class="card-grid">
      {stories.map((story) => <StoryCard story={story} locale={locale} />)}
    </div>
  </section>
  <section class="section container" aria-label={ui.seed}>
    <SeedNotice locale={locale} />
  </section>
</BaseLayout>

<style>
  .stats-band {
    padding: 4.5rem 0 2.5rem;
  }

  .stats-header {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    margin-bottom: 2.25rem;
  }

  @media (min-width: 768px) {
    .stats-header {
      flex-direction: row;
      align-items: flex-end;
      justify-content: space-between;
    }
  }

  .stats-ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .stats-cta-btn {
    gap: 0.5rem;
    font-size: 0.85rem;
    font-weight: 600;
  }

  .cta-arrow {
    transition: transform 150ms ease;
  }

  .stats-cta-btn:hover .cta-arrow {
    transform: translateX(3px);
  }

  .stats-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1rem;
  }

  @media (min-width: 900px) {
    .stats-grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 1.25rem;
    }
  }

  .stat-card {
    display: flex;
    flex-direction: column;
    padding: 1.5rem 1.4rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    background: var(--paper);
    box-shadow: 0 4px 20px rgba(26, 43, 38, 0.04);
    transition:
      transform 180ms ease,
      box-shadow 180ms ease;
  }

  .stat-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 30px rgba(26, 43, 38, 0.08);
  }

  .stat-label {
    margin: 0 0 0.35rem;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--terracotta);
  }

  .stat-value {
    font-family: Newsreader, Georgia, serif;
    font-size: clamp(1.8rem, 4vw, 2.4rem);
    font-weight: 500;
    line-height: 1.05;
    letter-spacing: -0.03em;
    color: var(--deep-olive);
    margin-bottom: 0.35rem;
  }

  .stat-caption {
    margin: 0;
    font-size: 0.88rem;
    line-height: 1.45;
    color: var(--muted);
  }

  .map-teaser-card {
    display: grid;
    grid-template-columns: 1fr;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: var(--paper);
    overflow: hidden;
    box-shadow: 0 4px 24px rgba(26, 43, 38, 0.06);
  }

  @media (min-width: 900px) {
    .map-teaser-card {
      grid-template-columns: 1.1fr 1fr;
      min-height: 25rem;
    }
  }

  .map-teaser-visual {
    position: relative;
    background: linear-gradient(135deg, #e4eae2 0%, #d5ded3 50%, #c8d3c5 100%);
    min-height: 16rem;
    overflow: hidden;
    border-bottom: 1px solid var(--line);
  }

  @media (min-width: 900px) {
    .map-teaser-visual {
      border-bottom: none;
      border-right: 1px solid var(--line);
      min-height: 100%;
    }
  }

  .map-teaser-canvas {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 1.25rem;
  }

  .map-teaser-grid {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(to right, rgba(36, 67, 63, 0.06) 1px, transparent 1px),
      linear-gradient(to bottom, rgba(36, 67, 63, 0.06) 1px, transparent 1px);
    background-size: 32px 32px;
    pointer-events: none;
  }

  .map-teaser-svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    pointer-events: none;
  }

  .map-teaser-pins {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .map-pin {
    position: absolute;
    display: flex;
    align-items: center;
    gap: 0.4rem;
    transform: translate(-50%, -50%);
    white-space: nowrap;
  }

  .map-pin-dot {
    width: 0.75rem;
    height: 0.75rem;
    border-radius: 50%;
    border: 2px solid white;
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.25);
  }

  .map-pin-dot--terracotta {
    background: var(--terracotta);
  }

  .map-pin-dot--sea {
    background: var(--sea);
  }

  .map-pin-dot--gold {
    background: var(--gold);
  }

  .map-pin-dot--olive {
    background: var(--olive);
  }

  .map-pin-label {
    font-size: 0.72rem;
    font-weight: 600;
    color: var(--ink);
    background: rgba(251, 249, 244, 0.92);
    padding: 0.15rem 0.45rem;
    border-radius: var(--radius-sm);
    border: 1px solid var(--line);
    box-shadow: 0 2px 6px rgba(26, 43, 38, 0.08);
    backdrop-filter: blur(4px);
  }

  .map-teaser-badge {
    position: relative;
    z-index: 1;
    align-self: flex-start;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.35rem 0.75rem;
    border-radius: 999px;
    background: rgba(251, 249, 244, 0.95);
    border: 1px solid var(--line);
    box-shadow: 0 2px 10px rgba(26, 43, 38, 0.08);
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--deep-olive);
    backdrop-filter: blur(4px);
  }

  .map-teaser-coords {
    position: relative;
    z-index: 1;
    align-self: flex-end;
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    color: var(--muted);
    background: rgba(251, 249, 244, 0.85);
    padding: 0.2rem 0.5rem;
    border-radius: var(--radius-sm);
  }

  .map-teaser-content {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 2rem 1.75rem;
    gap: 1.25rem;
  }

  @media (min-width: 900px) {
    .map-teaser-content {
      padding: 2.5rem 2.25rem;
    }
  }

  .map-teaser-heading {
    margin: 0;
    font-family: Newsreader, Georgia, serif;
    font-size: clamp(1.4rem, 2.5vw, 1.85rem);
    font-weight: 500;
    line-height: 1.15;
    letter-spacing: -0.02em;
    color: var(--deep-olive);
  }

  .map-teaser-desc {
    margin: 0;
    font-size: 0.92rem;
    line-height: 1.55;
    color: var(--muted);
  }

  .map-teaser-features {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .teaser-feature {
    display: flex;
    align-items: flex-start;
    gap: 0.65rem;
    font-size: 0.85rem;
    line-height: 1.4;
  }

  .feature-bullet {
    font-size: 1rem;
    line-height: 1.2;
    flex-shrink: 0;
  }

  .teaser-feature strong {
    display: block;
    color: var(--ink);
    font-weight: 600;
  }

  .teaser-feature span {
    color: var(--muted);
  }

  .map-teaser-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.85rem;
    margin-top: 0.5rem;
  }

  .map-cta-button {
    gap: 0.5rem;
    font-size: 0.9rem;
    font-weight: 600;
  }

  .map-secondary-button {
    font-size: 0.85rem;
  }
</style>
