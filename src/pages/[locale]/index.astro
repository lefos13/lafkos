---
import BaseLayout from '../../layouts/BaseLayout.astro';
import StoryCard from '../../components/StoryCard.astro';
import SeedNotice from '../../components/SeedNotice.astro';
import MapExplorer from '../../components/MapExplorer';
import { fetchSanityContent, publicMapData } from '../../lib/content-api';
import { locales, type Locale } from '../../lib/locales';
import { getCopy } from '../../lib/ui-copy';

export function getStaticPaths() {
  return locales.map((locale) => ({ params: { locale }, props: { locale } }));
}

const { locale } = Astro.props as { locale: Locale };
const ui = getCopy(locale);
const dataset = await fetchSanityContent();
/* Keep the landing page intentionally small: these four stable story keys are
 * invitations into the atlas, while the full archive remains on /stories/. */
const narrativeStarts = [
  { key: 'reading-lafkos', theme: 'origins-water', scope: 'walks' },
  { key: 'water-and-stone', theme: 'origins-water', scope: 'walks' },
  { key: 'oldest-cafe-forlidas', theme: 'square-1887', scope: 'village' },
  { key: 'kalderimia-pelion', theme: 'stone-craft', scope: 'walks' },
].flatMap(({ key, theme, scope }) => {
  const story = dataset.stories.find((item) => item.entityKey === key);
  return story ? [{ story, theme, scope }] : [];
});
const categories = dataset.categories;
---

<BaseLayout locale={locale} title={ui.explore} description={ui.introLong} darkHeader>
  <section class="hero">
    <div class="hero-content">
      <p class="eyebrow">Νότιο Πήλιο · South Pelion</p>
      <h1 class="display">{locale === 'el' ? 'Λαύκος' : 'Lafkos'}</h1>
      <p class="lede">{ui.introLong}</p>
      <div class="hero-actions">
        <a class="button button-primary" href={`/${locale}/map`}
          >{ui.explore} <span aria-hidden="true">↗</span></a
        >
        <a class="button button-ghost" href={`/${locale}/stories/`}>{ui.navStories}</a>
      </div>
    </div>
  </section>

  <section class="map-section container" aria-labelledby="map-title">
    <div class="section-header">
      <div>
        <p class="eyebrow">{ui.explore}</p><h2 id="map-title" class="section-title">
          {locale === 'el' ? 'Βρες τον δρόμο σου.' : 'Find your way in.'}
        </h2>
      </div>
      <a class="text-link" href={`/${locale}/map`}>{ui.viewAll}</a>
    </div>
    <MapExplorer
      client:load
      locale={locale}
      mapData={publicMapData(locale, dataset)}
      categories={categories}
    />
  </section>

  <section class="section container" aria-labelledby="starts-title">
    <div class="section-header">
      <div>
        <p class="eyebrow">{ui.featured}</p><h2 id="starts-title" class="section-title">
          {locale === 'el' ? 'Ξεκίνα από εδώ.' : 'Start here.'}
        </h2>
        <p class="lede">{ui.storiesIntro}</p>
      </div><a class="text-link" href={`/${locale}/stories/`}>{ui.viewAll}</a>
    </div>
    <div class="card-grid">
      {
        narrativeStarts.map(({ story, theme, scope }) => (
          <StoryCard
            story={story}
            locale={locale}
            mapHref={`/${locale}/map?scope=${scope}&theme=${theme}`}
          />
        ))
      }
    </div>
  </section>

  <section class="section container" aria-label={ui.seed}>
    <SeedNotice locale={locale} />
  </section>
</BaseLayout>
