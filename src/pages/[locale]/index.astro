---
import BaseLayout from '../../layouts/BaseLayout.astro';
import FeatureCard from '../../components/FeatureCard.astro';
import StoryCard from '../../components/StoryCard.astro';
import SeedNotice from '../../components/SeedNotice.astro';
import MapExplorer from '../../components/MapExplorer';
import { categories, featuredPlaces, featuredStories, featuredTrails, publicMapData } from '../../lib/content-api';
import { locales, type Locale } from '../../lib/locales';
import { getCopy } from '../../lib/ui-copy';

export function getStaticPaths() {
  return locales.map((locale) => ({ params: { locale }, props: { locale } }));
}

const { locale } = Astro.props as { locale: Locale };
const ui = getCopy(locale);
const places = featuredPlaces();
const trails = featuredTrails();
const stories = featuredStories();
---
<BaseLayout locale={locale} title={ui.explore} description={ui.introLong} darkHeader>
  <section class="hero">
    <div class="hero-content">
      <p class="eyebrow">Νότιο Πήλιο · South Pelion</p>
      <h1 class="display">{locale === 'el' ? 'Λαύκος' : 'Lafkos'}</h1>
      <p class="lede">{ui.introLong}</p>
      <div class="hero-actions">
        <a class="button button-primary" href={`/${locale}/map`}>{ui.explore} <span aria-hidden="true">↗</span></a>
        <a class="button button-ghost" href={`/${locale}/stories/reading-lafkos`}>{ui.readStory}</a>
      </div>
    </div>
  </section>

  <section class="map-section container" aria-labelledby="map-title">
    <div class="section-header">
      <div><p class="eyebrow">{ui.explore}</p><h2 id="map-title" class="section-title">{locale === 'el' ? 'Βρες τον δρόμο σου.' : 'Find your way in.'}</h2></div>
      <a class="text-link" href={`/${locale}/map`}>{ui.viewAll}</a>
    </div>
    <MapExplorer client:load locale={locale} mapData={publicMapData(locale)} categories={categories} />
  </section>

  <section class="section container" aria-labelledby="featured-title">
    <div class="section-header"><div><p class="eyebrow">{ui.featured}</p><h2 id="featured-title" class="section-title">{locale === 'el' ? 'Ξεκίνα από εδώ.' : 'Start here.'}</h2></div><a class="text-link" href={`/${locale}/map`}>{ui.viewAll}</a></div>
    <div class="card-grid">
      {places.map((place) => <FeatureCard entry={place} locale={locale} category={categories.find((category) => category.id === place.category)} />)}
      {trails.map((trail) => <FeatureCard entry={trail} locale={locale} category={categories.find((category) => category.id === 'trail')} />)}
    </div>
  </section>

  <section class="section container" aria-labelledby="stories-title">
    <div class="section-header"><div><p class="eyebrow">{ui.stories}</p><h2 id="stories-title" class="section-title">{locale === 'el' ? 'Ο τόπος συνεχίζει να μιλά.' : 'The place keeps speaking.'}</h2></div><a class="text-link" href={`/${locale}/stories/reading-lafkos`}>{ui.viewAll}</a></div>
    <div class="card-grid">{stories.map((story) => <StoryCard story={story} locale={locale} />)}</div>
  </section>

  <section class="section container" aria-label={ui.seed}>
    <SeedNotice locale={locale} />
  </section>
</BaseLayout>
