---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import SeedNotice from '../../../components/SeedNotice.astro';
import ShareActions from '../../../components/ShareActions.astro';
import ResponsiveImage from '../../../components/ResponsiveImage.astro';
import {
  fetchSanityContent,
  getLocalizedEditorialMetadata,
  type ContentDataset,
} from '../../../lib/content-api';
import { locales, otherLocale, type Locale } from '../../../lib/locales';
import { getAbsoluteCanonicalUrl } from '../../../lib/urls';
import { getCopy } from '../../../lib/ui-copy';
import { formatDistance } from '../../../lib/geometry';
import type { Trail } from '../../../lib/content';
import { parseYouTubeVideoId } from '../../../lib/video';
import { buildTrailJsonLd, formatSeoSnippet } from '../../../lib/structured-data';

export async function getStaticPaths() {
  const dataset = await fetchSanityContent();
  return locales.flatMap((locale) =>
    dataset.trails.map((trail) => ({
      params: { locale, slug: trail.slug[locale] },
      props: { locale, trail, dataset },
    })),
  );
}
const { locale, trail, dataset } = Astro.props as {
  locale: Locale;
  trail: Trail;
  dataset: ContentDataset;
};
const ui = getCopy(locale);
const category = dataset.categories.find((item) => item.id === 'trail');
// Only a successfully parsed YouTube id produces an embed; other hosts are blocked by CSP anyway.
const videoId = parseYouTubeVideoId(trail.videoUrl ?? '');

/*
 * Editorial and SEO metadata overrides:
 * Allows CMS-defined titles, summaries, social images, author attribution,
 * and publication/modification timestamps to override default fields.
 * Explicit editorial descriptions are preserved verbatim, while summary
 * fallbacks are normalized and word-boundary truncated via formatSeoSnippet.
 */
const editorial = getLocalizedEditorialMetadata(trail, locale);
const seoTitle = editorial.title ?? trail.title[locale];
const seoDescription = editorial.description ?? formatSeoSnippet(trail.summary[locale]);
const primaryImage = trail.waypoints.find((w) => w.image)?.image ?? trail.waypoints[0]?.image;
const socialImage = editorial.socialImage?.src ?? primaryImage?.src;
const socialImageAlt = editorial.socialImage?.alt ?? primaryImage?.alt ?? trail.title[locale];
/*
 * Structured Data:
 * BreadcrumbList and Schema.org TouristTrip graphs with verified images.
 */
const jsonLd = buildTrailJsonLd({
  trail,
  locale,
  editorial,
  seoDescription,
  seoTitle,
});
const canonicalPath = `/${locale}/trails/${trail.slug[locale]}/`;
const canonicalUrl = getAbsoluteCanonicalUrl(canonicalPath);
---

<BaseLayout
  locale={locale}
  title={seoTitle}
  description={seoDescription}
  image={socialImage}
  imageAlt={socialImageAlt}
  type="article"
  author={editorial.author}
  publishedAt={editorial.publishedAt}
  modifiedAt={editorial.modifiedAt}
  jsonLd={jsonLd}
  alternateHref={`/${otherLocale(locale)}/trails/${trail.slug[otherLocale(locale)]}/`}
>
  <article class="container">
    <div class="detail-hero">
      <div class="detail-media">
        <ResponsiveImage
          src={trail.waypoints[0]?.image?.src ??
            'https://images.unsplash.com/photo-1473448912268-2022ce9509d8?auto=format&fit=crop&w=1400&q=82'}
          alt={trail.waypoints[0]?.image?.alt ?? trail.title[locale]}
          preset="hero"
          loading="eager"
          decoding="async"
          fetchpriority="high"
        />
      </div>
      <div class="detail-copy">
        <p class="eyebrow">{category?.label[locale]} · {trail.eyebrow[locale]}</p>
        <h1 class="page-title">{trail.title[locale]}</h1>
        <p class="lede">{trail.summary[locale]}</p>
        <div class="detail-meta">
          <span class="meta-pill"
            >⌁ {formatDistance(trail.distanceMeters, locale)} {ui.distance}</span
          ><span class="meta-pill">◷ {trail.durationMinutes}′ {ui.duration}</span><span
            class="meta-pill">↟ {trail.elevationGainMeters} m {ui.elevation}</span
          ><span class="meta-pill">{ui[trail.difficulty]}</span>
        </div>
        <div class="hero-actions">
          <a class="button button-primary" href={`/${locale}/map/?trail=${trail.entityKey}`}
            >{ui.openMap} <span aria-hidden="true">↗</span></a
          ><a
            class="button button-secondary"
            href={`https://www.openstreetmap.org/?mlat=${trail.geometry.coordinates[0][1]}&mlon=${trail.geometry.coordinates[0][0]}#map=16/${trail.geometry.coordinates[0][1]}/${trail.geometry.coordinates[0][0]}`}
            rel="noreferrer">{ui.directions}</a
          >
        </div>
        {trail.isSeed && <SeedNotice locale={locale} />}
        <ShareActions
          locale={locale}
          canonicalUrl={canonicalUrl}
          title={trail.title[locale]}
          description={trail.summary[locale]}
        />
      </div>
    </div>
    <div class="prose-layout prose-section">
      <aside><p class="eyebrow">{ui.safety}</p></aside>
      <div class="prose-copy">
        {trail.body[locale].map((paragraph) => <p>{paragraph}</p>)}
        <ul>{trail.safety[locale].map((item) => <li>{item}</li>)}</ul>
        {
          videoId && (
            <>
              <p class="eyebrow">{ui.video}</p>
              <figure class="video-embed">
                <iframe
                  src={`https://www.youtube-nocookie.com/embed/${videoId}`}
                  title={trail.title[locale]}
                  loading="lazy"
                  allowfullscreen
                  referrerpolicy="strict-origin-when-cross-origin"
                  allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                />
              </figure>
            </>
          )
        }
        <h2 class="section-title">{locale === 'el' ? 'Σημεία στη διαδρομή' : 'Waypoints'}</h2>
        {
          trail.waypoints.map((waypoint) => (
            <div class="story-card" style="margin: 1rem 0;">
              <div class="story-card-copy">
                <>
                  <p class="eyebrow">{waypoint.title[locale]}</p>
                  <p>
                    {waypoint.coordinate[1].toFixed(4)}, {waypoint.coordinate[0].toFixed(4)}
                  </p>
                </>
              </div>
              {waypoint.image && (
                <ResponsiveImage
                  src={waypoint.image.src}
                  alt={waypoint.image.alt}
                  preset="waypoint"
                  loading="lazy"
                  decoding="async"
                />
              )}
            </div>
          ))
        }
        <h2 class="section-title">{ui.sources}</h2>
        <ul class="source-list">
          {
            trail.sources.map((item) => (
              <li>
                <a href={item.url} target="_blank" rel="noreferrer">
                  {item.label} ↗
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </article>
</BaseLayout>
