---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import SeedNotice from '../../../components/SeedNotice.astro';
import ShareActions from '../../../components/ShareActions.astro';
import ResponsiveImage from '../../../components/ResponsiveImage.astro';
import {
  fetchSanityContent,
  getLocalizedEditorialMetadata,
  type ContentDataset,
} from '../../../lib/content-api';
import { locales, otherLocale, type Locale } from '../../../lib/locales';
import { getAbsoluteCanonicalUrl } from '../../../lib/urls';
import { getCopy } from '../../../lib/ui-copy';
import type { Place } from '../../../lib/content';
import { parseYouTubeVideoId } from '../../../lib/video';
import { buildPlaceJsonLd, formatSeoSnippet } from '../../../lib/structured-data';
export async function getStaticPaths() {
  const dataset = await fetchSanityContent();
  return locales.flatMap((locale) =>
    dataset.places.map((place) => ({
      params: { locale, slug: place.slug[locale] },
      props: { locale, place, dataset },
    })),
  );
}
const { locale, place, dataset } = Astro.props as {
  locale: Locale;
  place: Place;
  dataset: ContentDataset;
};
const ui = getCopy(locale);
const category = dataset.categories.find((item) => item.id === place.category);
// Only a successfully parsed YouTube id produces an embed; other hosts are blocked by CSP anyway.
const videoId = parseYouTubeVideoId(place.videoUrl ?? '');

/*
 * Editorial and SEO metadata overrides:
 * Allows CMS-defined titles, summaries, social images, author attribution,
 * and publication/modification timestamps to override default fields.
 * Explicit editorial descriptions are preserved verbatim, while summary
 * fallbacks are normalized and word-boundary truncated via formatSeoSnippet.
 */
const editorial = getLocalizedEditorialMetadata(place, locale);
const seoTitle = editorial.title ?? place.title[locale];
const seoDescription = editorial.description ?? formatSeoSnippet(place.summary[locale]);
const primaryImage = place.images[0];
const socialImage = editorial.socialImage?.src ?? primaryImage?.src;
const socialImageAlt = editorial.socialImage?.alt ?? primaryImage?.alt ?? place.title[locale];
/*
 * Structured Data:
 * BreadcrumbList and Schema.org TouristAttraction graphs with real coordinates and images.
 */
const jsonLd = buildPlaceJsonLd({
  place,
  locale,
  editorial,
  seoDescription,
  seoTitle,
});
const canonicalPath = `/${locale}/places/${place.slug[locale]}/`;
const canonicalUrl = getAbsoluteCanonicalUrl(canonicalPath);
---

<BaseLayout
  locale={locale}
  title={seoTitle}
  description={seoDescription}
  image={socialImage}
  imageAlt={socialImageAlt}
  type="article"
  author={editorial.author}
  publishedAt={editorial.publishedAt}
  modifiedAt={editorial.modifiedAt}
  alternateHref={`/${otherLocale(locale)}/places/${place.slug[otherLocale(locale)]}/`}
  jsonLd={jsonLd}
>
  <article class="container">
    <div class="detail-hero">
      <div class="detail-media">
        <ResponsiveImage
          src={place.images[0].src}
          alt={place.images[0].alt}
          preset="hero"
          loading="eager"
          decoding="async"
          fetchpriority="high"
        />
      </div>
      <div class="detail-copy">
        <p class="eyebrow">{category?.label[locale]} · {place.eyebrow[locale]}</p>
        <h1 class="page-title">{place.title[locale]}</h1>
        <p class="lede">{place.summary[locale]}</p>
        <div class="hero-actions">
          <a class="button button-primary" href={`/${locale}/map/?place=${place.entityKey}`}
            >{ui.openMap} <span aria-hidden="true">↗</span></a
          ><a
            class="button button-secondary"
            href={`https://www.openstreetmap.org/?mlat=${place.mapAnchor[1]}&mlon=${place.mapAnchor[0]}#map=18/${place.mapAnchor[1]}/${place.mapAnchor[0]}`}
            rel="noreferrer">{ui.directions}</a
          >
        </div>
        {place.isSeed && <SeedNotice locale={locale} />}
        <ShareActions
          locale={locale}
          canonicalUrl={canonicalUrl}
          title={place.title[locale]}
          description={place.summary[locale]}
        />
      </div>
    </div>
    <div class="prose-layout prose-section">
      <aside><p class="eyebrow">{ui.practical}</p></aside>
      <div class="prose-copy">
        {place.body[locale].map((paragraph) => <p>{paragraph}</p>)}
        <ul>{place.practical[locale].map((item) => <li>{item}</li>)}</ul>
        {
          videoId && (
            <>
              <p class="eyebrow">{ui.video}</p>
              <figure class="video-embed">
                <iframe
                  src={`https://www.youtube-nocookie.com/embed/${videoId}`}
                  title={place.title[locale]}
                  loading="lazy"
                  allowfullscreen
                  referrerpolicy="strict-origin-when-cross-origin"
                  allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                />
              </figure>
            </>
          )
        }
        <h2 class="section-title">{ui.sources}</h2>
        <ul class="source-list">
          {
            place.sources.map((item) => (
              <li>
                <a href={item.url} target="_blank" rel="noreferrer">
                  {item.label} ↗
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </article>
</BaseLayout>
