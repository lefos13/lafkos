---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import MapExplorer from '../../../components/MapExplorer';
import SeedNotice from '../../../components/SeedNotice.astro';
import { categories, publicMapData } from '../../../lib/content-api';
import { locales, type Locale } from '../../../lib/locales';
import { getCopy } from '../../../lib/ui-copy';
import { parseMapState } from '../../../lib/map-state';

export function getStaticPaths() {
  return locales.map((locale) => ({ params: { locale }, props: { locale } }));
}
const { locale } = Astro.props as { locale: Locale };
const ui = getCopy(locale);
---
<BaseLayout locale={locale} title={ui.explore} description={ui.introLong}>
  <section class="prose-section container">
    <p class="eyebrow">{ui.explore}</p>
    <h1 class="page-title">{locale === 'el' ? 'Ο Λαύκος, σημείο προς σημείο.' : 'Lafkos, point by point.'}</h1>
    <p class="lede">{ui.introLong}</p>
  </section>
  <section class="map-section container" aria-label={ui.explore}>
    <MapExplorer client:load locale={locale} mapData={publicMapData(locale)} categories={categories} initialState={parseMapState(Astro.url.search)} />
    <SeedNotice locale={locale} />
  </section>
</BaseLayout>
