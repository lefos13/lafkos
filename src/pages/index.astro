---
const preferred = 'el';
const target = `/${preferred}/`;
---

<!doctype html>
<html lang="el">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Lafkos Guide — Οδηγός Λαύκου</title>
    <link rel="canonical" href={new URL(target, Astro.site ?? 'https://lafkos.guide')} />
    <meta name="robots" content="noindex, follow" />
    <meta http-equiv="refresh" content={`0;url=${target}`} />
    <script is:inline define:vars={{ target }}>
      window.location.replace(target);
    </script>
    <style>
      :root {
        color-scheme: light;
      }
      body {
        margin: 0;
        min-height: 100vh;
        background-color: #f4efe4;
        color: #24433f;
        font-family:
          system-ui,
          -apple-system,
          BlinkMacSystemFont,
          'Segoe UI',
          Roboto,
          sans-serif;
        display: flex;
        align-items: center;
        justify-content: center;
      }
      a {
        color: #24433f;
      }
    </style>
  </head>
  <body>
    <noscript>
      <p>
        Μετάβαση στον <a href={target}>Οδηγό Λαύκου</a>. / Go to <a href={target}>Lafkos Guide</a>.
      </p>
    </noscript>
  </body>
</html>
