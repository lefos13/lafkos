---
import { getResponsiveImageAttributes, type ImagePresetName } from '../lib/images';

interface Props {
  src: string;
  alt: string;
  preset?: ImagePresetName;
  widths?: readonly number[];
  defaultWidth?: number;
  sizes?: string;
  loading?: 'lazy' | 'eager';
  decoding?: 'async' | 'sync' | 'auto';
  fetchpriority?: 'high' | 'low' | 'auto';
  class?: string;
  width?: number;
  height?: number;
  style?: string;
}

const {
  src,
  alt,
  preset,
  widths,
  defaultWidth,
  sizes: customSizes,
  loading = 'lazy',
  decoding = 'async',
  fetchpriority,
  class: className,
  width,
  height,
  style,
} = Astro.props;

const {
  src: optimizedSrc,
  srcset,
  sizes,
} = getResponsiveImageAttributes({
  src,
  preset,
  widths,
  defaultWidth,
  sizes: customSizes,
});
---

<img
  src={optimizedSrc}
  srcset={srcset}
  sizes={sizes}
  alt={alt}
  loading={loading}
  decoding={decoding}
  fetchpriority={fetchpriority}
  class={className}
  width={width}
  height={height}
  style={style}
/>
