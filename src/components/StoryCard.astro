---
import type { Story } from '../lib/content';
import type { Locale } from '../lib/locales';
import { getCopy } from '../lib/ui-copy';

/* Story cards now carry lightweight orientation metadata and optional links
 * back into the map, keeping narrative reading connected to place discovery. */
interface Props {
  story: Story;
  locale: Locale;
  mapHref?: string;
  relatedEntries?: Array<{ title: string; href: string }>;
}
const { story, locale, mapHref, relatedEntries = [] } = Astro.props;
const ui = getCopy(locale);
const wordCount = story.body[locale].join(' ').split(/\s+/).filter(Boolean).length;
const readingMinutes = Math.max(2, Math.ceil(wordCount / 100));
const readingTimeLabel = `~${readingMinutes} ${ui.minutesRead}`;
---

<article class="story-card">
  <img src={story.image.src} alt={story.image.alt} loading="lazy" />
  <div class="story-card-copy">
    <p class="eyebrow">{story.eyebrow[locale]}</p>
    <h3>{story.title[locale]}</h3>
    <p>{story.summary[locale]}</p>
    <div class="story-card-meta">
      <span class="story-read-time">{readingTimeLabel}</span>
      <a class="text-link" href={`/${locale}/stories/${story.slug[locale]}`}>{ui.readStory}</a>
    </div>
    {
      mapHref && (
        <a class="story-map-link" href={mapHref}>
          {ui.exploreTheme} <span aria-hidden="true">↗</span>
        </a>
      )
    }
    {
      relatedEntries.length > 0 && (
        <div class="story-card-related">
          <p>{ui.relatedPlaces}</p>
          <ul>
            {relatedEntries.map((entry) => (
              <li>
                <a href={entry.href}>{entry.title}</a>
              </li>
            ))}
          </ul>
        </div>
      )
    }
  </div>
</article>
