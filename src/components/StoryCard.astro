---
import type { Story } from '../lib/content';
import type { Locale } from '../lib/locales';
import { getCopy } from '../lib/ui-copy';

interface Props {
  story: Story;
  locale: Locale;
}
const { story, locale } = Astro.props;
const ui = getCopy(locale);
---

<article class="story-card">
  <img src={story.image.src} alt={story.image.alt} loading="lazy" />
  <div class="story-card-copy">
    <p class="eyebrow">{story.eyebrow[locale]}</p>
    <h3>{story.title[locale]}</h3>
    <p>{story.summary[locale]}</p>
    <a class="text-link" href={`/${locale}/stories/${story.slug[locale]}`}>{ui.readStory}</a>
  </div>
</article>
