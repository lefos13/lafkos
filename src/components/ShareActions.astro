---
import { getCopy } from '../lib/ui-copy';
import type { Locale } from '../lib/locales';
import { buildShareUrls } from '../lib/urls';

interface Props {
  locale: Locale;
  canonicalUrl: string;
  title: string;
  description?: string;
  class?: string;
}

const { locale, canonicalUrl, title, description, class: className } = Astro.props;

const ui = getCopy(locale);
const shareUrls = buildShareUrls({
  canonicalUrl,
  title,
});
---

<section
  class:list={['share-actions', className]}
  aria-label={ui.shareAriaGroup}
  data-share-actions
>
  <div class="share-actions-inner">
    <span class="share-actions-label">{ui.shareTitle}:</span>
    <div class="share-actions-buttons" role="group" aria-label={ui.shareAriaGroup}>
      <!-- Web Share API Button (progressively enabled when supported) -->
      <button
        type="button"
        class="share-btn share-btn--native"
        data-share-native
        data-share-url={canonicalUrl}
        data-share-title={title}
        data-share-text={description || title}
        aria-label={ui.shareNative}
        hidden
      >
        <svg
          class="share-icon"
          width="15"
          height="15"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <circle cx="18" cy="5" r="3"></circle>
          <circle cx="6" cy="12" r="3"></circle>
          <circle cx="18" cy="19" r="3"></circle>
          <line x1="8.59" y1="13.51" x2="15.42" y2="17.49"></line>
          <line x1="15.41" y1="6.51" x2="8.59" y2="10.49"></line>
        </svg>
        <span class="share-btn-text">{ui.shareNative}</span>
      </button>

      <!-- Facebook Share Link -->
      <a
        href={shareUrls.facebook}
        target="_blank"
        rel="noopener noreferrer"
        class="share-btn share-btn--facebook"
        aria-label={ui.shareFacebook}
      >
        <svg
          class="share-icon"
          width="15"
          height="15"
          viewBox="0 0 24 24"
          fill="currentColor"
          aria-hidden="true"
        >
          <path
            d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"
          ></path>
        </svg>
        <span class="share-btn-text">Facebook</span>
      </a>

      <!-- X Share Link -->
      <a
        href={shareUrls.x}
        target="_blank"
        rel="noopener noreferrer"
        class="share-btn share-btn--x"
        aria-label={ui.shareX}
      >
        <svg
          class="share-icon"
          width="14"
          height="14"
          viewBox="0 0 24 24"
          fill="currentColor"
          aria-hidden="true"
        >
          <path
            d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"
          ></path>
        </svg>
        <span class="share-btn-text">X</span>
      </a>

      <!-- WhatsApp Share Link -->
      <a
        href={shareUrls.whatsapp}
        target="_blank"
        rel="noopener noreferrer"
        class="share-btn share-btn--whatsapp"
        aria-label={ui.shareWhatsApp}
      >
        <svg
          class="share-icon"
          width="15"
          height="15"
          viewBox="0 0 24 24"
          fill="currentColor"
          aria-hidden="true"
        >
          <path
            d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"
          ></path>
        </svg>
        <span class="share-btn-text">WhatsApp</span>
      </a>

      <!-- Copy Link Button -->
      <button
        type="button"
        class="share-btn share-btn--copy"
        data-share-copy
        data-copy-url={canonicalUrl}
        data-copied-text={ui.shareCopied}
        data-default-text={ui.shareCopyLink}
        data-failed-text={ui.shareCopyFailed}
        aria-label={ui.shareCopyLink}
      >
        <svg
          class="share-icon share-icon--copy"
          width="15"
          height="15"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"></path>
          <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"></path>
        </svg>
        <svg
          class="share-icon share-icon--check"
          width="15"
          height="15"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.5"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
          style="display: none;"
        >
          <polyline points="20 6 9 17 4 12"></polyline>
        </svg>
        <span class="share-btn-text" data-copy-label>{ui.shareCopyLink}</span>
      </button>
    </div>
  </div>

  <!-- Screen reader accessible live region -->
  <span class="share-status sr-only" role="status" aria-live="polite" data-share-status></span>
</section>

<script>
  function initShareActions() {
    const containers = document.querySelectorAll<HTMLElement>(
      '[data-share-actions]:not([data-share-initialized])',
    );

    containers.forEach((container) => {
      container.setAttribute('data-share-initialized', 'true');

      // Native Web Share API progressive enhancement
      const nativeBtn = container.querySelector<HTMLButtonElement>('[data-share-native]');
      if (nativeBtn && typeof navigator !== 'undefined' && typeof navigator.share === 'function') {
        nativeBtn.removeAttribute('hidden');
        nativeBtn.addEventListener('click', async () => {
          const url = nativeBtn.dataset.shareUrl || window.location.href;
          const title = nativeBtn.dataset.shareTitle || document.title;
          const text = nativeBtn.dataset.shareText || '';
          try {
            await navigator.share({ title, text, url });
          } catch (err) {
            if ((err as Error)?.name !== 'AbortError') {
              console.error('Web share failed', err);
            }
          }
        });
      }

      // Copy Link Button with accessible feedback
      const copyBtn = container.querySelector<HTMLButtonElement>('[data-share-copy]');
      const statusEl = container.querySelector<HTMLElement>('[data-share-status]');
      let resetTimer: ReturnType<typeof setTimeout> | null = null;

      if (copyBtn) {
        copyBtn.addEventListener('click', async () => {
          const url = copyBtn.dataset.copyUrl || window.location.href;
          const copiedText = copyBtn.dataset.copiedText || 'Copied!';
          const defaultText = copyBtn.dataset.defaultText || 'Copy link';
          const failedText = copyBtn.dataset.failedText || 'Failed to copy';
          const labelEl = copyBtn.querySelector<HTMLElement>('[data-copy-label]');
          const copyIcon = copyBtn.querySelector<SVGElement>('.share-icon--copy');
          const checkIcon = copyBtn.querySelector<SVGElement>('.share-icon--check');

          let success = false;
          try {
            if (navigator.clipboard && typeof navigator.clipboard.writeText === 'function') {
              await navigator.clipboard.writeText(url);
              success = true;
            } else {
              // Intentional legacy browser fallback isolated behind a typed boundary
              const textArea = document.createElement('textarea');
              textArea.value = url;
              textArea.style.position = 'fixed';
              textArea.style.left = '-999999px';
              textArea.style.top = '-999999px';
              textArea.setAttribute('readonly', '');
              document.body.appendChild(textArea);
              textArea.focus();
              textArea.select();
              try {
                const legacyDoc: unknown = document;
                const isLegacyDocument = (
                  doc: unknown,
                ): doc is { execCommand(commandId: string): boolean } =>
                  Boolean(doc && typeof doc === 'object' && 'execCommand' in doc);
                success = isLegacyDocument(legacyDoc) ? legacyDoc.execCommand('copy') : false;
              } finally {
                textArea.remove();
              }
            }
          } catch {
            success = false;
          }

          if (resetTimer) clearTimeout(resetTimer);

          if (success) {
            copyBtn.setAttribute('data-copied', 'true');
            if (labelEl) labelEl.textContent = copiedText;
            if (copyIcon) copyIcon.style.display = 'none';
            if (checkIcon) checkIcon.style.display = 'inline-block';
            if (statusEl) statusEl.textContent = copiedText;

            resetTimer = setTimeout(() => {
              copyBtn.removeAttribute('data-copied');
              if (labelEl) labelEl.textContent = defaultText;
              if (copyIcon) copyIcon.style.display = 'inline-block';
              if (checkIcon) checkIcon.style.display = 'none';
              if (statusEl) statusEl.textContent = '';
            }, 3000);
          } else {
            if (labelEl) labelEl.textContent = failedText;
            if (statusEl) statusEl.textContent = failedText;
            resetTimer = setTimeout(() => {
              if (labelEl) labelEl.textContent = defaultText;
              if (statusEl) statusEl.textContent = '';
            }, 3000);
          }
        });
      }
    });
  }

  if (typeof document !== 'undefined') {
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initShareActions, { once: true });
    } else {
      initShareActions();
    }
    document.addEventListener('astro:page-load', initShareActions);
  }
</script>

<style>
  .share-actions {
    margin-top: 1.25rem;
    padding: 0.75rem 0.95rem;
    background: rgba(251, 249, 244, 0.75);
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
  }

  .share-actions-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem 0.85rem;
  }

  .share-actions-label {
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--muted);
    user-select: none;
    flex-shrink: 0;
  }

  .share-actions-buttons {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.45rem;
  }

  .share-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.38rem;
    min-height: 44px;
    min-width: 44px;
    padding: 0.45rem 0.75rem;
    background: var(--limestone);
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    color: var(--deep-olive);
    font-size: 0.82rem;
    font-weight: 600;
    line-height: 1;
    text-decoration: none;
    cursor: pointer;
    box-sizing: border-box;
    transition:
      transform 140ms ease,
      background-color 140ms ease,
      border-color 140ms ease,
      color 140ms ease;
  }

  .share-btn:hover {
    background: var(--paper);
    border-color: var(--sea);
    color: var(--sea);
    transform: translateY(-1px);
  }

  .share-btn:focus-visible {
    outline: 2px solid var(--sea);
    outline-offset: 2px;
  }

  .share-btn[data-copied='true'] {
    background: rgba(46, 119, 118, 0.12);
    border-color: var(--sea);
    color: var(--sea);
  }

  .share-btn[hidden] {
    display: none !important;
  }

  .share-icon {
    display: inline-block;
    flex-shrink: 0;
    vertical-align: middle;
  }

  .share-btn-text {
    display: inline-block;
    white-space: nowrap;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border-width: 0;
  }

  @media (max-width: 480px) {
    .share-actions {
      padding: 0.65rem 0.75rem;
    }

    .share-actions-inner {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.5rem;
    }

    .share-actions-buttons {
      width: 100%;
    }

    .share-btn {
      flex: 1 1 auto;
      padding: 0.45rem 0.6rem;
      font-size: 0.78rem;
    }
  }
</style>
