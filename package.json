{
  "name": "lafkos-guide",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "dev:stop": "astro dev stop",
    "build": "astro build",
    "preview": "astro preview",
    "lint": "eslint .",
    "check": "astro check",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:seo": "astro build && pnpm audit:seo",
    "test:e2e": "playwright test",
    "audit:seo": "tsx scripts/audit-seo.ts && STRICT_SEO_AUDIT=true vitest run tests/build-seo-audit.test.ts",
    "format": "prettier --write .",
    "studio:dev": "pnpm --filter @lafkos/studio dev",
    "studio:build": "pnpm --filter @lafkos/studio build",
    "studio:deploy": "pnpm --filter @lafkos/studio run deploy",
    "studio:export-seed": "tsx scripts/export-sanity-seed.ts",
    "studio:import-seed": "pnpm --filter @lafkos/studio import-seed",
    "studio:pull-content": "tsx scripts/pull-sanity-content.ts",
    "vercel-ignore": "bash scripts/ignore-app-build.sh"
  },
  "dependencies": {
    "@astrojs/react": "^6.0.6",
    "@astrojs/sitemap": "^3.7.4",
    "@sanity/client": "^8.11.0",
    "@sanity/image-url": "^2.1.1",
    "astro": "^7.4.2",
    "maplibre-gl": "^6.15.0",
    "pmtiles": "^4.5.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/parser": "^8.72.0",
    "eslint": "^9.39.5",
    "eslint-plugin-astro": "^1.7.0",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^0.14.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  }
}
