{
  "name": "lafkos-guide",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "dev:stop": "astro dev stop",
    "build": "astro build",
    "preview": "astro preview",
    "lint": "eslint .",
    "check": "astro check",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "format": "prettier --write .",
    "studio:dev": "pnpm --filter @lafkos/studio dev",
    "studio:build": "pnpm --filter @lafkos/studio build",
    "studio:deploy": "pnpm --filter @lafkos/studio deploy",
    "studio:export-seed": "tsx scripts/export-sanity-seed.ts",
    "studio:import-seed": "pnpm --filter @lafkos/studio import-seed",
    "vercel-ignore": "bash scripts/ignore-app-build.sh"
  },
  "dependencies": {
    "@astrojs/react": "^6.0.4",
    "@astrojs/sitemap": "^3.7.0",
    "@sanity/client": "^8.1.0",
    "@sanity/image-url": "^2.1.1",
    "astro": "^7.2.4",
    "maplibre-gl": "^6.4.1",
    "pmtiles": "^4.5.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.5",
    "@playwright/test": "^1.62.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@typescript-eslint/parser": "^8.67.0",
    "eslint": "^9.39.0",
    "eslint-plugin-astro": "^1.5.0",
    "prettier": "^3.6.2",
    "prettier-plugin-astro": "^0.14.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
